---
import Layout from "../layouts/Layout.astro";
import CapstoneCard from "../components/CapstoneCard.astro";
import capstones from "../data/capstones.json";

// Get unique courses for filtering
const courses = [...new Set(capstones.map((c) => c.course))];
---

<Layout>
  <!-- Hero Section -->
  <div class="banner">
    <h1>CAPSTONE SHOWCASE</h1>
    <p>
      Discover how CIIT's artists weaved their vision <br />
      into reality from a living archive of student's capstones
    </p>
    <div class="search-bar-container">
      <div class="search-bar">
        <span class="material-symbols-outlined">search</span>
        <input
          type="text"
          id="searchInput"
          placeholder="Find inspiration from projects and authors"
        />
      </div>
      <div class="filter-sort-bar">
        <!-- Filter Dropdown -->
        <div class="dropdown">
          <button class="dropdown-toggle" type="button">
            Filter <span class="material-symbols-outlined">filter_alt</span>
          </button>
          <ul class="dropdown-menu">
            <li>
              <a class="dropdown-item" href="#" data-filter="All">All Courses</a
              >
            </li>
            {
              courses.map((course) => (
                <li>
                  <a class="dropdown-item" href="#" data-filter={course}>
                    {course}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Sort Controls -->
        <div class="sort-controls">
          <!-- Sort Dropdown -->
          <div class="dropdown">
            <button class="dropdown-toggle" type="button">
              Sort <span class="material-symbols-outlined">sort</span>
            </button>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" href="#" data-sort="Relevance"
                  >Relevance</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#" data-sort="Year">Year</a>
              </li>
              <li>
                <a class="dropdown-item" href="#" data-sort="Most Viewed"
                  >Most Viewed</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#" data-sort="Highest Rated"
                  >Highest Rated</a
                >
              </li>
            </ul>
          </div>

          <!-- Direction Toggle Button -->
          <div class="sort-direction">
            <button class="direction-btn active" data-direction="desc" title="Descending (newest first)">
              <span class="material-symbols-outlined">arrow_downward</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Masonry Grid -->
  <div class="masonry-grid" id="capstoneGrid">
    {capstones.map((capstone) => <CapstoneCard capstone={capstone} />)}
  </div>

  <script>
    // Client-side filtering logic
    document.addEventListener("DOMContentLoaded", () => {
      const grid = document.getElementById("capstoneGrid");
      const cards = grid.querySelectorAll(".masonry-item");
      const searchInput = document.getElementById("searchInput");
      const filterItems = document.querySelectorAll(
        ".dropdown-item[data-filter]",
      );
      const sortItems = document.querySelectorAll(".dropdown-item[data-sort]");
      const directionBtns = document.querySelectorAll(".direction-btn");

      // Track current sort state
      let currentSort = "Year";
      let sortDirection = "desc";

      // Dropdown Toggle Functionality
      const dropdownToggles = document.querySelectorAll(".dropdown-toggle");

      dropdownToggles.forEach((toggle) => {
        toggle.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const dropdown = toggle.closest(".dropdown");
          const menu = dropdown.querySelector(".dropdown-menu");

          // Close all other dropdowns first
          document.querySelectorAll(".dropdown-menu").forEach((m) => {
            if (m !== menu) m.classList.remove("show");
          });

          // Toggle current dropdown
          menu.classList.toggle("show");
        });
      });

      // Close dropdowns when clicking outside
      document.addEventListener("click", () => {
        document.querySelectorAll(".dropdown-menu").forEach((menu) => {
          menu.classList.remove("show");
        });
      });

      // Filter Function
      function filterCards(category) {
        cards.forEach((card) => {
          const cardCategory = card.getAttribute("data-category");
          if (category === "All" || cardCategory === category) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      }

      // Search Function
      function searchCards(query) {
        const lowerQuery = query.toLowerCase();
        cards.forEach((card) => {
          const title = card.querySelector("h3").textContent.toLowerCase();
          const author = card
            .querySelector(".author")
            .textContent.toLowerCase();
          if (title.includes(lowerQuery) || author.includes(lowerQuery)) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      }

      // Sort Function
      function sortCards(criteria, direction = "desc") {
        const cardsArray = Array.from(cards);

        // We need to sort ALL cards, not just visible ones, to maintain state correctly
        // But for simplicity, let's just sort the visible ones and re-append them

        switch (criteria) {
          case "Year":
            cardsArray.sort((a, b) => {
              const yearA = parseInt(a.querySelector(".year").textContent);
              const yearB = parseInt(b.querySelector(".year").textContent);
              // Direction-aware sorting
              return direction === "desc" ? yearB - yearA : yearA - yearB;
            });
            break;
          case "Highest Rated":
            // Simulate rating by sorting by title descending (A-Z reversed)
            cardsArray.sort((a, b) => {
              const titleA = a.querySelector("h3").textContent;
              const titleB = b.querySelector("h3").textContent;
              // Direction-aware sorting
              return direction === "desc" 
                ? titleB.localeCompare(titleA) 
                : titleA.localeCompare(titleB);
            });
            break;
          case "Most Viewed":
            // Random shuffle for simulation (direction doesn't apply here)
            cardsArray.sort(() => Math.random() - 0.5);
            break;
          case "Relevance":
          default:
            // Default order - do nothing or reset to original
            // In a real app, we'd store original indices
            break;
        }

        // Re-append sorted cards
        cardsArray.forEach((card) => grid.appendChild(card));
      }

      // Event Listeners for filter and sort items
      filterItems.forEach((item) => {
        item.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          filterCards(e.target.getAttribute("data-filter"));
          // Close dropdown after selection
          document.querySelectorAll(".dropdown-menu").forEach((menu) => {
            menu.classList.remove("show");
          });
        });
      });

      searchInput.addEventListener("input", (e) => {
        searchCards(e.target.value);
      });

      // Sort item click handler
      sortItems.forEach((item) => {
        item.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          currentSort = e.target.getAttribute("data-sort");
          sortCards(currentSort, sortDirection);
          // Close dropdown after selection
          document.querySelectorAll(".dropdown-menu").forEach((menu) => {
            menu.classList.remove("show");
          });
        });
      });

      // Direction button click handler - TOGGLE between asc/desc
      directionBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          // Toggle direction
          sortDirection = sortDirection === "desc" ? "asc" : "desc";
          
          // Update button icon
          const icon = btn.querySelector(".material-symbols-outlined");
          icon.textContent = sortDirection === "desc" 
            ? "arrow_downward" 
            : "arrow_upward";
          
          // Update title
          btn.title = sortDirection === "desc" 
            ? "Descending (newest first)" 
            : "Ascending (oldest first)";
          
          // Update data attribute
          btn.dataset.direction = sortDirection;
          
          // Re-sort with new direction
          sortCards(currentSort, sortDirection);
        });
      });

      // Apply default sort on page load
      sortCards(currentSort, sortDirection);
    });
  </script>
</Layout>
