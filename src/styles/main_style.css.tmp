@import url("https://fonts.googleapis.com/css2?family=Racing+Sans+One&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap");
@import "./reset.css";
@import "./variables.css";

body {
    margin: 0;
    background-color: var(--gray-0);
    font-family: var(--font-sans);
}

.banner {
    /* Apply a dark overlay and a background image */
    background:
        linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 40, 57, 0.8) 45%,
            rgba(0, 54, 77, 1) 100%
        ),
        repeat url("/ciit_banner.svg");
    background-size: auto;
    background-position: center;
    padding: var(--size-8) var(--size-5);
    gap: var(--size-4);
    color: var(--gray-0);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    h1 {
        font-size: var(--font-size-fluid-3);
        font-family: "Lorcan Mist";
        line-height: 1.1;
    }
    p {
        font-size: var(--font-size-fluid-1);
    }
}

/* Masonry Layout */
.masonry-grid {
    column-count: 3;
    column-gap: var(--size-5);
    padding: var(--size-5);
    max-width: 1200px;
    margin: 0 auto;
}

@media (max-width: 992px) {
    .masonry-grid {
        column-count: 2;
    }
}

@media (max-width: 576px) {
    .masonry-grid {
        column-count: 1;
    }
}

/* Unified Search Bar Container */
.search-bar-container {
    display: flex;
    width: calc(var(--size-fluid-10) * 1.5);
    gap: var(--size-2);
    align-items: center;
    background-color: var(--white-bg-color);
    border-radius: var(--radius-2);
}

/* Search bar */
.search-bar {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: center;
    padding: var(--size-1) var(--size-3);
    gap: var(--size-1);
}

.search-bar input[type="text"] {
    flex: 1;
    min-width: 0;
    padding: var(--size-2);
    border: none;
    border-radius: 0;
    font-size: var(--font-size-1);
    background: transparent;
    color: var(--gray-8);
    outline: none;
}

/* Dropdown buttons styling */
.dropdown-toggle {
    padding: var(--size-1) var(--size-3);
    border: 1px solid var(--gray-3);
    background-color: transparent;
    color: var(--gray-8);
    cursor: pointer;
    font-size: var(--font-size-1);
    transition:
        background-color var(--ease-3),
        border-color var(--ease-3);
    display: inline-flex;
    align-items: center;
    gap: var(--size-1);
    border-radius: var(--radius-2);
}

.dropdown-toggle:hover {
    background-color: rgba(0, 0, 0, 0.05);
    border-color: var(--gray-4);
}

/* Filter/Sort bar */
.filter-sort-bar {
    padding: var(--size-2) var(--size-2);
    display: flex;
    gap: var(--size-1);
    flex-shrink: 0;
    align-items: center;
}

/* Sort Controls Container */
.sort-controls {
    display: flex;
    align-items: center;
    gap: var(--size-1);
}

/* Sort Direction Buttons */
.sort-direction {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.direction-btn {
    padding: var(--size-half);
    border: 1px solid var(--gray-3);
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--ease-3);
}

.direction-btn .material-symbols-outlined {
    font-size: var(--font-size-1);
    color: var(--gray-6);
}

.direction-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    border-color: var(--gray-4);
}

.direction-btn.active {
    background-color: var(--button-bg-color);
    border-color: var(--button-bg-color);
}

.direction-btn.active .material-symbols-outlined {
    color: var(--header-bg-color);
}

/* Dropdown menu alignment - always align to the left */
.dropdown-menu {
    top: calc(100% + var(--size-1));
    left: 0;
    right: auto;
}

/* HTML/Body overflow control for mobile */
html {
    overflow-x: hidden;
}

body {
    min-width: 100vw;
    overflow-x: hidden;
}

/* Mobile responsive styles */
