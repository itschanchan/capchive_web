---
const { capstone } = Astro.props;
---

<a href={`/capstone/${capstone.id}`} class="masonry-item" data-category={capstone.course}>
  <div class="card-content">
    <div class="card-image">
      <img src={capstone.image} alt={capstone.title} />
    </div>
    <div class="card-details">
      <h3>{capstone.title}</h3>
      <p class="author">{capstone.authors}</p>
      <div class="tags">
        <span class="tag year">{capstone.year}</span>
        <span class="tag course">{capstone.course}</span>
      </div>
    </div>
  </div>
</a>

<style>
  .masonry-item {
    display: block;
    background: var(--gray-0);
    border-radius: var(--radius-3);
    overflow: hidden;
    box-shadow: var(--shadow-1);
    transition: transform var(--ease-3), box-shadow var(--ease-3);
    text-decoration: none;
    color: inherit;
    margin-bottom: var(--size-3);
    break-inside: avoid;
  }

  .masonry-item:hover {
    transform: translateY(var(--size-1));
    box-shadow: var(--shadow-2);
  }

  .card-content {
    padding: var(--size-3);
  }

  .card-image {
    width: 100%;
    height: var(--size-fluid-2);
    min-height: var(--size-fluid-1);
    overflow: hidden;
    border-radius: var(--radius-1);
    margin-bottom: var(--size-3);
    background: var(--gray-1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card-details h3 {
    margin: 0 0 var(--size-1) 0;
    font-size: var(--font-size-2);
    color: var(--gray-8);
  }

  .author {
    color: var(--gray-5);
    margin-bottom: var(--size-1);
    font-size: var(--font-size-0);
  }

  .tags {
    display: flex;
    gap: var(--size-1);
    flex-wrap: wrap;
  }

  .tag {
    padding: var(--size-half) var(--size-2);
    border-radius: var(--radius-4);
    font-size: var(--font-size-00);
    font-weight: var(--font-weight-6);
  }

  .year {
    background-color: var(--button-hover-bg-color, var(--gray-3));
    color: var(--header-bg-color, var(--gray-8));
  }

  .course {
    background-color: var(--nav-btn-bg-color, var(--gray-2));
    color: var(--header-bg-color, var(--gray-8));
  }
</style>
